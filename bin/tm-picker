#!/usr/bin/env bash
# tm-picker - interactive tmux session picker backed by terminal_picker_cc/picker.
# Lists sessions in a colored table (icon, name, window count, attached) with a
# type-to-create row first. Falls back to the plain-text tm-menu when the
# graphical picker is not available.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

resolve_picker() {
    if command -v picker >/dev/null 2>&1; then
        command -v picker
        return 0
    fi
    local p="$HOME/public/terminal_picker_cc/picker"
    if [[ -x "$p" ]]; then
        echo "$p"
        return 0
    fi
    return 1
}

PICKER="$(resolve_picker)" || exec "$SCRIPT_DIR/tm-menu"

# Prefer the tmux profile's @machine_label (e.g. "phone"), else the hostname.
label="$(tmux show -gv @machine_label 2>/dev/null || true)"
[[ -z "$label" ]] && label="$(hostname)"

rows=()
while IFS='|' read -r name windows attached; do
    [[ -z "$name" ]] && continue
    if [[ "$attached" == "1" ]]; then
        icon="{cyan}●{/}"
        status="  {yellow}(attached){/}"
    else
        icon="{dim}○{/}"
        status=""
    fi
    namecol="$(printf '%-20s' "$name")"
    rows+=("$name"$'\t'"$icon  $namecol $windows windows$status")
done < <(tmux list-sessions -F '#{session_name}|#{session_windows}|#{?session_attached,1,0}' 2>/dev/null)

header="tmux on $label: pick a session or type a new name"
header+=$'\n'"↑↓ move · type to create · enter select · esc cancel"

sel="$("$PICKER" \
    --header "$header" \
    --custom --custom-first \
    --custom-label "{green}+{/}  {dim}new session name...{/}" \
    --marker "▶ " \
    "${rows[@]}")" || exit 0

[[ -z "$sel" ]] && exit 0
exec tmux new-session -A -s "$sel"
