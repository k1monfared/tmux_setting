#!/usr/bin/env bash
# tm-login - shell-login entry to the tmux session picker.
# Runs on interactive shell start. Skips (dropping to a plain shell) when
# already inside tmux, in VS Code, in Guake, or when the graphical picker is
# absent. Delegates the actual choosing to tm-picker.

[ -n "${TMUX:-}" ] && exit 0                # already inside tmux -> nothing to do
[ "${TERM_PROGRAM:-}" = "vscode" ] && exit 0   # VS Code integrated terminal
[ -n "${GUAKE_TAB_UUID:-}" ] && exit 0         # Guake drop-down terminal

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The graphical picker must be present; otherwise drop to a plain shell.
if ! command -v picker >/dev/null 2>&1 && [[ ! -x "$HOME/public/terminal_picker_cc/picker" ]]; then
    exit 0
fi

exec "$SCRIPT_DIR/tm-picker"
